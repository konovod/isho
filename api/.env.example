# API
#
# `.env` is loaded in every environment, specs included, and its values win over
# the environment variables that are already set. That is why `LUCKY_ENV` and
# `DEV_PORT` stay out of it: `script/dev-api.ps1` sets them, and specs set their
# own. Copy this file to `.env` only for what the app needs at runtime.
#
# Production database (development uses localhost defaults from config/database.cr)
# DATABASE_URL=postgres://user:password@host:5432/isho_production

# Production media storage (not implemented yet; Latch FileSystem for now)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Mail. Without MAIL_ADAPTER the letters are printed to the log instead of
# being sent (dev and test), which is enough to follow confirmation links.
# MAIL_ADAPTER=smtp
# MAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_TLS=ssl
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=
# SMTP_HELO_DOMAIN=
# EMAIL_CONFIRMATION=off disables the requirement (accounts confirm on sign-up).
# EMAIL_CONFIRMATION=on

# AI on the forum (DeepSeek). Without AI_API_KEY every AI feature stays off.
# AI_ENABLED=off turns it off even when a key is present.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# Daily ceiling for the whole server; the worker sleeps when it is reached.
# AI_DAILY_JOBS=200
# AI_DAILY_INPUT_TOKENS=1500000
# AI_DAILY_OUTPUT_TOKENS=300000
