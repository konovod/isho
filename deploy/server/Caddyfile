# isho in front of the Lucky API and the Nuxt server.
#
# ISHO_SITE_ADDRESS comes from /etc/isho/caddy.env:
#   :80                                  plain HTTP on any host (no domain yet)
#   https://isho.duckdns.org             automatic HTTPS once DNS points here
#   https://185-180-231-183.nip.io       same, without owning a domain
#
# Certificates are kept in the file storage below, so restarts and redeploys
# never re-issue them (Let's Encrypt counts every issuance per domain).
{
	admin off
	storage file_system /var/lib/caddy

	# Per-project game hosts (deploy/server/Caddyfile.media) get their
	# certificate during the first handshake. The API allows only hosts of
	# existing projects, so the server cannot issue certificates for arbitrary
	# names and is not a certificate vending machine.
	on_demand_tls {
		ask http://127.0.0.1:4000/internal/tls/allow
	}
}

{$ISHO_SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
